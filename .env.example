# Copy to .env.local (gitignored). Never put secrets in the repo.

# Write APIs (/api/seed, /api/collect POST)
# Production: both required. STAR_ALLOW_WRITE=1 without a token is 403.
STAR_ALLOW_WRITE=
STAR_WRITE_TOKEN=

# In-memory write limiter (single Node process). Defaults: 30 / 60000ms.
# WARNING: effective ONLY on a single process. Horizontal scaling (>1 instance)
# REQUIRES replacing this with a shared store (Redis/DB) — otherwise the per-
# instance ceiling can be bypassed multiplicatively. See docs/deploy/SINGLE_NODE.md.
STAR_WRITE_RATE_LIMIT=30
STAR_WRITE_RATE_WINDOW_MS=60000

# Server PGlite data directory (single-node + persistent volume)
PGLITE_DATA_DIR=

# Data provider. solana-rpc stays blocked until the license matrix enables it.
STAR_DATA_PROVIDER=fixture
STAR_RPC_URL=

# Build identity (optional)
STAR_COMMIT_SHA=
NEXT_PUBLIC_BUILD_SHA=

# Execution. Default is DRY_RUN. Broadcast requires BOTH flags AND a live
# adapter (not wired). Never put a keypair in git.
STAR_MICRO_LIVE=
STAR_JUPITER_EXECUTE=
STAR_WALLET_KEYPAIR=

# Tests only — not a production switch
STAR_SMOKE=
STAR_ENGINEERING_OVERRIDE=
E2E_BASE_URL=
